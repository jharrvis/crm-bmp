APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Asia/Jakarta
AUTH_REGISTRATION_ENABLED=false

# IP Restriction for web routes (dashboard, admin panel)
# Comma-separated CIDR ranges. Example: "114.30.0.0/16,10.0.0.0/8"
# Leave empty to disable IP restriction.
ALLOWED_IPS_CIDR=114.30.0.0/16

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

ZABBIX_API_URL=
ZABBIX_USERNAME=
ZABBIX_PASSWORD=
ZABBIX_VERIFY_SSL=false

# HestiaCP integration (TLS verification aktif secara default)
HESTIACP_VERIFY_SSL=true

# Domain Registrar SRS-X (global kill-switch & mode read_only/managed)
DOMAIN_REGISTRAR_ENABLED=false
DOMAIN_REGISTRAR_MODE=read_only
DOMAIN_REGISTRAR_TIMEOUT=30
DOMAIN_REGISTRAR_VERIFY_SSL=true
# Menit toleransi operasi berstatus processing sebelum dianggap stale (worker mati/timeout) dan di-retry aman
DOMAIN_REGISTRAR_OPERATION_STALE_MINUTES=30
DOMAIN_REGISTRAR_SRSX_ENABLED=true

CLIENT_PORTAL_OTP_LENGTH=6
CLIENT_PORTAL_OTP_TTL=10
CLIENT_PORTAL_OTP_MAX_ATTEMPTS=5
CLIENT_PORTAL_OTP_REQUEST_LIMIT=5
CLIENT_PORTAL_OTP_REQUEST_DECAY_SECONDS=60
CLIENT_PORTAL_TOKEN_TTL_DAYS=30
CLIENT_PORTAL_APP_URL=https://client-portal-roan-five.vercel.app

GITHUB_REPO=jharrvis/crm-bmp
GITHUB_BRANCH=master
GITHUB_TOKEN=

MAP_PROVIDER=openstreetmap
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION="&copy; <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a> contributors"
MAP_NOMINATIM_URL=https://nominatim.openstreetmap.org/search
MAP_NOMINATIM_USER_AGENT="BMPnet CRM/1.0 (+https://example.com; contact: support@example.com)"
MAP_NOMINATIM_TIMEOUT=8
MAP_NOMINATIM_RESULT_LIMIT=5
MAP_NOMINATIM_CACHE_DAYS=30
